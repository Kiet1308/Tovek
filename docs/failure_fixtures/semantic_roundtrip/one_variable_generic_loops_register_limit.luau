-- Each generic `for` holds its generator, state and control, and room for
-- two variables even when it names one: six nested one-variable loops hold
-- thirty registers, not twenty-four. With 180 parameters and two calls of
-- 44 values the bytecode needs exactly 255; flattening the two `do` blocks
-- keeps `x` live across the second call, one register past Luau's limit,
-- unless the locals share storage.
local sink = 0
local function g(...)
    sink += select("#", ...)
end
local function once()
    local done = false
    return function()
        if done then
            return nil
        end
        done = true
        return 1
    end
end
