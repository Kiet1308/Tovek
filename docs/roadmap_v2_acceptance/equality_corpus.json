  "runtime_harness": {
   "driver": "\nlocal createSpy = loadModule()\nfor _, throws in { false, true } do\n    local trace = {}\n    local mt = { __eq = function(left, right)\n        table.insert(trace, left.label .. \":\" .. right.label)\n        if throws and left.label == \"actual\" then error(\"ordered-equality\") end\n        return left.label == \"actual\"\n    end }\n    local actual = setmetatable({ label = \"actual\" }, mt)\n    local expected = setmetatable({ label = \"expected\" }, mt)\n    local spy = createSpy()\n    spy.value(actual)\n    local ok, value = pcall(function() spy:assertCalledWith(expected) end)\n    print(throws, ok, not ok and string.find(tostring(value), \"ordered-equality\", 1, true) ~= nil)\n    print(table.concat(trace, \",\"))\nend\n",
   "prefix": "local function loadModule()\nlocal script = { Parent = { assertDeepEqual = {} } }\nlocal require = function(_) return function() error(\"unused deep comparator\") end end\n"
  }
