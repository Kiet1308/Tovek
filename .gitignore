# Build artifacts
/target/
**/target/

# Member-crate lock files. The workspace-root Cargo.lock is the single source of
# truth and IS committed, so downloads build against pinned, reproducible deps.
/*/Cargo.lock

# Profiling / heap-debug output
flamegraph.svg
*.profraw
dhat-heap.json
__pycache__/

# Decompiler scratch output (test dumps, sample bytecode, ad-hoc runs)
result.lua
*_out.txt
*_out.json
*.bin
/_trace_*
# Local corpus runs and one-off debugging. Keep checked-in fixtures under docs.
/tmp_*
/*.err
/out/
/out_*/
/selectedOut_*/
/review_src_*/
/repro_*.luac

# Editors / IDEs
.idea/
.vscode/
*.swp
*~

# Local agent / tooling state
.claude/

# AI experiments remain local and disabled by default. Never publish weights
# or model caches to GitHub (including through Git LFS).
*.gguf
*.ggml
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
/ai-models/
/model-cache/
**/.cache/huggingface/
**/.ollama/

# OS cruft
.DS_Store
Thumbs.db
